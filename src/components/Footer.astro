---
import { address, navigation, site, telHref } from '../lib/site'
---

<footer class="site-footer">
    <div class="wrap footer-grid">
        <div>
            <img class="footer-logo" src="/logo.png" width="196" height="111" alt="Sol och Dur" />
            <p>
                {site.street}<br />
                {site.postalCode}
                {site.city}
            </p>
            <p>
                <a href={telHref(site.phone)}>{site.phone}</a><br />
                <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
        </div>
        <nav aria-label="Sidor">
            <h2>Sidor</h2>
            <ul>
                {
                    navigation.map((item) => (
                        <li>
                            <a href={item.href}>{item.label}</a>
                        </li>
                    ))
                }
            </ul>
        </nav>
        <nav aria-label="Dokument">
            <h2>Dokument</h2>
            <ul>
                <li><a href="/styrdokument-handlingsplaner/">Styrdokument och handlingsplaner</a></li>
                <li><a href="/synpunkter/">Klagomålshantering</a></li>
                <li><a href="/forskolan-sol-och-durs-integritetsskyddspolicy/">Integritetsskyddspolicy</a></li>
                <li><a href={site.surveyUrl}>Resultat i Stockholms stads förskoleundersökning</a></li>
            </ul>
        </nav>
    </div>
    <div class="wrap footer-bottom">
        <p>© {new Date().getFullYear()} Sol och Dur ekonomisk förening, {address}</p>
    </div>
</footer>
