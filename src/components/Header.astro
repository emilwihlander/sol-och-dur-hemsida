---
import { navigation } from '../lib/site'

const current = Astro.url.pathname
---

<header class="site-header">
    <div class="wrap header-inner">
        <a class="brand" href="/">
            <img src="/logo.png" width="196" height="111" alt="Sol och Dur, till startsidan" />
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Meny</button>
        <nav id="site-nav" class="site-nav" aria-label="Huvudmeny">
            <ul>
                {
                    navigation.map((item) => (
                        <li>
                            <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
                                {item.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
            <a class="button" href="/kontakt/#ansok">Ansök om plats</a>
        </nav>
    </div>
</header>

<script>
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle')
    const nav = document.querySelector('.site-nav')

    toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open') ?? false
        toggle.setAttribute('aria-expanded', String(open))
    })
</script>
